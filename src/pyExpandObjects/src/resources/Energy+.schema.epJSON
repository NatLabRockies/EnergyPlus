                            "enum": [
                                "",
                                "InchPound",
                                "JtoGJ",
                                "JtoKWH",
                                "JtoMJ",
                                "None",
                                "UseOutputControlTableStyle"
                            ],
                            "default": "UseOutputControlTableStyle"
                        }
