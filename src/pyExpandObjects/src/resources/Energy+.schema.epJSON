            "type": "object",
            "memo": "Determines the availability of a loop or system: whether it is on or off. Depending on zone temperatures, overrides Schedules and forces system Fans on.",
            "min_fields": 6.0
        },
        "AvailabilityManager:DifferentialThermostat": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
