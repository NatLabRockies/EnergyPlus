                            "default": 1.0,
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "maximum": 10.0,
                            "exclusiveMaximum": true
                        },
                        "maximum_running_time_before_allowing_electric_resistance_heat_use_during_shdwh_mode": {
