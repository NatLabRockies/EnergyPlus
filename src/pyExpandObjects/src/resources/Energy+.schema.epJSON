                            "data_type": "object_list",
                            "object_list": [
                                "ScheduleNames"
                            ]
                        },
                        "cooling_low_control_temperature_schedule_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "ScheduleNames"
                            ]
                        },
                        "number_of_circuits": {
                            "type": "string",
