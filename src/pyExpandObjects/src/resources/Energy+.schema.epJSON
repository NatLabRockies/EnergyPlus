        "Chiller:EngineDriven": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
                    "properties": {
                        "condenser_type": {
                            "type": "string",
                            "enum": [
                                "",
                                "AirCooled",
                                "EvaporativelyCooled",
                                "WaterCooled"
                            ],
                            "default": "AirCooled"
                        },
                        "nominal_capacity": {
                            "units": "W",
                            "anyOf": [
                                {
                                    "type": "number",
                                    "minimum": 0.0
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "Autosize"
                                    ]
                                }
                            ]
                        },
                        "nominal_cop": {
                            "type": "number",
                            "units": "W/W",
                            "note": "Nominal Refrigeration Cycle COP",
                            "minimum": 0.0,
                            "exclusiveMinimum": true
