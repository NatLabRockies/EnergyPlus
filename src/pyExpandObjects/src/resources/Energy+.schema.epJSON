                            "maximum": 1.0
                        },
                        "visible_absorptance": {
                            "type": "number",
                            "minimum": 0.0,
                            "default": 0.7,
                            "maximum": 1.0
                        }
                    },
                    "required": [
                        "roughness",
                        "thickness",
                        "conductivity",
                        "density",
                        "specific_heat"
