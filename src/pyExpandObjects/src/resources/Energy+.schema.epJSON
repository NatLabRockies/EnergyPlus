        "WindowMaterial:Gap": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
                    "properties": {
                        "thickness": {
                            "type": "number",
                            "units": "m",
                            "minimum": 0.0,
                            "exclusiveMinimum": true
                        },
                        "gas_or_gas_mixture_": {
                            "type": "string",
                            "note": "This field should reference only WindowMaterial:Gas or WindowMaterial:GasMixture objects",
