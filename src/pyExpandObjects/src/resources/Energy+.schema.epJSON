                            ]
                        },
                        "maximum_net_electrical_power_rate_of_change": {
                            "type": "number",
                            "units": "W/s"
                        },
                        "maximum_fuel_flow_rate_of_change": {
                            "type": "number",
                            "units": "kg/s2"
                        },
                        "heat_exchanger_u_factor_times_area_value": {
                            "type": "number",
