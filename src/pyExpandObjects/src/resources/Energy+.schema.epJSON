                        "field_name": "Flow Rate per Zone Floor Area",
                        "field_type": "n"
                    },
                    "flow_rate_per_person": {
                        "field_name": "Flow Rate per Person",
                        "field_type": "n"
                    },
                    "air_changes_per_hour": {
