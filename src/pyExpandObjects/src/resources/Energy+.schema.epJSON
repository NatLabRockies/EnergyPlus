                            "type": "number",
                            "minimum": 1.0,
                            "exclusiveMinimum": true
                        },
                        "visible_extinction_coefficient": {
                            "type": "number",
                            "units": "1/m",
                            "minimum": 0.0,
                            "exclusiveMinimum": true
                        },
                        "infrared_transmittance_at_normal_incidence": {
                            "type": "number",
                            "maximum": 1.0,
                            "exclusiveMaximum": true,
                            "minimum": 0.0,
                            "default": 0.0
                        },
                        "infrared_hemispherical_emissivity": {
                            "type": "number",
                            "note": "Emissivity of front and back side assumed equal",
                            "maximum": 1.0,
                            "exclusiveMaximum": true,
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "default": 0.84
                        },
                        "conductivity": {
                            "type": "number",
                            "units": "W/m-K",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "default": 0.9
                        },
                        "dirt_correction_factor_for_solar_and_visible_transmittance": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "maximum": 1.0,
                            "default": 1.0
                        },
                        "solar_diffusing": {
                            "type": "string",
                            "enum": [
                                "",
                                "No",
                                "Yes"
                            ],
                            "default": "No"
                        }
                    },
                    "required": [
                        "thickness",
                        "solar_index_of_refraction",
                        "solar_extinction_coefficient",
                        "visible_index_of_refraction",
                        "visible_extinction_coefficient"
                    ]
                }
            },
