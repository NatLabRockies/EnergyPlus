                            "exclusiveMinimum": true,
                            "units": "m",
                            "default": 0.3
                        },
                        "dgravzn_gravel_depth_extending_above_the_floor_slab": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "units": "m",
                            "default": 0.2
                        },
                        "dgravzp_gravel_depth_below_the_floor_slab": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "units": "m",
                            "default": 0.1
                        }
                    }
                }
