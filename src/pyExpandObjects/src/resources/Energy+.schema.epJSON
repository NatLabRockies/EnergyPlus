                        },
                        "air_side_fouling_factor": {
                            "type": "number",
                            "note": "For Fouling Input Method: FoulingFactor",
                            "units": "m2-K/W",
                            "minimum": 0.0,
                            "default": 0.0
                        },
                        "outside_coil_surface_area": {
                            "type": "number",
                            "note": "For Fouling Input Method: FoulingFactor",
                            "units": "m2",
                            "minimum": 0.0,
                            "exclusiveMinimum": true
                        },
                        "inside_to_outside_coil_surface_area_ratio": {
                            "type": "number",
                            "note": "For Fouling Input Method: FoulingFactor",
                            "units": "dimensionless",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "default": 0.07
