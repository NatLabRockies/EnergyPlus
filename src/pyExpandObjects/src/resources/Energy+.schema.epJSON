                        },
                        "surface_2_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "AllHeatTranSurfNames"
                            ]
                        },
                        "angle_factor_2": {
                            "type": "number",
                            "minimum": 0.0,
                            "maximum": 1.0
                        },
                        "surface_3_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "AllHeatTranSurfNames"
                            ]
                        },
                        "angle_factor_3": {
                            "type": "number",
                            "minimum": 0.0,
                            "maximum": 1.0
                        },
                        "surface_4_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "AllHeatTranSurfNames"
                            ]
                        },
                        "angle_factor_4": {
                            "type": "number",
                            "minimum": 0.0,
                            "maximum": 1.0
                        },
                        "surface_5_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "AllHeatTranSurfNames"
                            ]
                        },
                        "angle_factor_5": {
