                "type": "string"
            },
            "legacy_idd": {
                "field_info": {
                    "name": {
                        "field_name": "Name",
                        "field_type": "a"
                    },
                    "suffix_for_file_name_in_run": {
                        "field_name": "Suffix for File Name in Run",
