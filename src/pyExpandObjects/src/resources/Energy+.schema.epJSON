                                "FluidNames"
                            ]
                        },
                        "fluid_property_type": {
                            "type": "string",
                            "note": "Enthalpy Units are J/kg Density Units are kg/m3 SpecificHeat Units are J/kg-K Pressure Units are Pa",
                            "enum": [
