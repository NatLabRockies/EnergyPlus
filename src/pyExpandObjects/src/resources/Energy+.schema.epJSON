                            "units": "dimensionless",
                            "minimum": 0.0,
                            "maximum": 1.0,
                            "exclusiveMaximum": true
                        },
                        "infrared_hemispherical_emissivity": {
                            "type": "number",
                            "units": "dimensionless",
                            "maximum": 1.0,
                            "exclusiveMaximum": true,
                            "minimum": 0.0,
                            "exclusiveMinimum": true
