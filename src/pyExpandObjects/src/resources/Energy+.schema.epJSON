                        },
                        "hot_air_inlet_node_name": {
                            "type": "string"
                        },
                        "cold_air_inlet_node_name": {
                            "type": "string"
                        },
                        "maximum_air_flow_rate": {
                            "units": "m3/s",
                            "anyOf": [
                                {
                                    "type": "number",
                                    "minimum": 0.0
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "Autosize"
                                    ]
                                }
                            ]
                        }
                    },
                    "required": [
                        "air_outlet_node_name",
                        "hot_air_inlet_node_name",
                        "cold_air_inlet_node_name",
                        "maximum_air_flow_rate"
