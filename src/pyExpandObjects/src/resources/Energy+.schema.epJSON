        "AirflowNetwork:MultiZone:WindPressureCoefficientValues": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
                    "properties": {
                        "airflownetwork_multizone_windpressurecoefficientarray_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "WPCSetNames"
                            ],
                            "note": "Enter the name of the AirflowNetwork:Multizone:WindPressureCoefficientArray object."
                        },
                        "wind_pressure_coefficient_value_1": {
                            "type": "number",
                            "units": "dimensionless",
                            "note": "Enter the WPC Value corresponding to the 1st wind direction."
                        },
                        "wind_pressure_coefficient_value_2": {
                            "type": "number",
                            "units": "dimensionless",
                            "note": "Enter the WPC Value corresponding to the 2nd wind direction."
                        },
                        "wind_pressure_coefficient_value_3": {
