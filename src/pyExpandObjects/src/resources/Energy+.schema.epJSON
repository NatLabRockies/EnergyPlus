                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "default": 25.0
                        },
                        "initial_pressure": {
                            "type": "number",
                            "note": "This is pressure in time of window fabrication",
                            "units": "Pa",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "default": 101325.0
                        }
                    }
                }
