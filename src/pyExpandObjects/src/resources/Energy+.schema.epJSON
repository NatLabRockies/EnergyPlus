                        "back_side_shade_beam_diffuse_solar_transmittance",
                        "front_side_shade_beam_diffuse_solar_reflectance",
                        "back_side_shade_beam_diffuse_solar_reflectance"
                    ]
                }
            },
            "group": "Surface Construction Elements",
            "name": {
