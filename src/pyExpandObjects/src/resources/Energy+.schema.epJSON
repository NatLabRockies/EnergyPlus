                    },
                    "maximum_outdoor_dry_bulb_temperature_for_supplemental_heater_operation": {
                        "field_name": "Maximum Outdoor Dry-Bulb Temperature for Supplemental Heater Operation",
                        "field_type": "n"
                    },
                    "outdoor_dry_bulb_temperature_sensor_node_name": {
