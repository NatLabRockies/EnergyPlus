                        "severity_schedule_name",
                        "cooling_tower_object_type",
                        "cooling_tower_object_name"
                    ]
                },
                "numerics": {
                    "fields": [
                        "reference_ua_reduction_factor"
                    ]
                }
            },
            "type": "object",
            "memo": "This object describes the fault of fouling cooling towers",
            "min_fields": 6.0
        },
        "FaultModel:Fouling:Coil": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
