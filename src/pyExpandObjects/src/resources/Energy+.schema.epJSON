                "alphas": {
                    "fields": [
                        "name",
                        "spectrum_data_method",
                        "solar_spectrum_data_object_name",
                        "visible_spectrum_data_object_name"
                    ]
                },
                "numerics": {
                    "fields": []
                }
            },
            "type": "object",
            "maxProperties": 1,
            "memo": "If this object is omitted, the default solar and visible spectrum data will be used."
        },
        "Site:SpectrumData": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
