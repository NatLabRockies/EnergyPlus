                            "data_type": "object_list",
                            "object_list": [
                                "SpectrumDataNames"
                            ]
                        },
                        "visible_spectrum_data_object_name": {
                            "type": "string",
                            "data_type": "object_list",
                            "object_list": [
                                "SpectrumDataNames"
                            ]
                        }
                    }
                }
