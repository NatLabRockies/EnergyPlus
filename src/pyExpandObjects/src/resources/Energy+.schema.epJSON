                            "type": "number",
                            "units": "dimensionless"
                        },
                        "surface_layer_penetration_depth": {
                            "units": "m",
                            "ip-units": "in",
                            "default": "Autocalculate",
                            "anyOf": [
                                {
                                    "type": "number",
                                    "minimum": 0.0,
                                    "exclusiveMinimum": true
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "",
                                        "Autocalculate"
                                    ]
                                }
                            ]
                        },
                        "deep_layer_penetration_depth": {
                            "units": "m",
