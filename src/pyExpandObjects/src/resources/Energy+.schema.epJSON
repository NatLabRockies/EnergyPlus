                                    "exclusiveMinimum": true
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "Autosize"
                                    ]
                                }
                            ]
                        },
                        "nominal_secondary_air_inlet_temperature": {
                            "type": "number",
                            "units": "C"
                        },
                        "nominal_electric_power": {
                            "type": "number",
                            "units": "W",
                            "ip-units": "W"
                        },
                        "supply_air_inlet_node_name": {
                            "type": "string"
                        },
                        "supply_air_outlet_node_name": {
                            "type": "string"
                        },
                        "secondary_air_inlet_node_name": {
