        "Output:EnvironmentalImpactFactors": {
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties": {
                        "reporting_frequency": {
                            "type": "string",
                            "note": "Timestep refers to the zone Timestep/Number of Timesteps in hour value RunPeriod and Environment are the same. Detailed is not a valid choice.",
                            "enum": [
                                "Annual",
                                "Daily",
                                "Environment",
                                "Hourly",
                                "Monthly",
                                "RunPeriod",
                                "Timestep"
