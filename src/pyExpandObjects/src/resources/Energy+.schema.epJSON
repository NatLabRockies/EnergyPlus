                                "ThermalStorage:Ice:Simple"
                            ]
                        },
                        "component_1_name": {
                            "type": "string",
                            "note": "This field is the name of either the chiller or ice storage equipment on the loop.",
                            "data_type": "object_list",
                            "object_list": [
                                "Chillers",
                                "IceThermalStorageEquipment"
                            ]
                        },
                        "component_1_demand_calculation_node_name": {
                            "type": "string",
