                    "drybulb_temperature_schedule_name",
                    "wetbulb_temperature_schedule_name",
                    "wind_speed_schedule_name",
                    "wind_direction_schedule_name",
                    "wind_pressure_coefficient_curve_name",
                    "symmetric_wind_pressure_coefficient_curve",
                    "wind_angle_type"
