                        },
                        "dilution_outlet_air_node_name": {
                            "type": "string"
                        },
                        "minimum_operating_point": {
                            "type": "number",
                            "units": "W"
                        },
                        "maximum_operating_point": {
                            "type": "number",
                            "units": "W"
                        }
                    },
                    "required": [
                        "efficiency_curve_name"
                    ]
                }
            },
            "group": "Electric Load Center-Generator Specifications",
