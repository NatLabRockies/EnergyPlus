                                        "anyOf": [
                                            {
                                                "type": "number"
                                            },
                                            {
                                                "type": "string"
                                            }
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                }
            },
            "group": "Schedules",
            "name": {
                "type": "string",
