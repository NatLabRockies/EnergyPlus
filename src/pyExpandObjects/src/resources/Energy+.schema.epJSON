        "Curve:Linear": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
                    "properties": {
                        "coefficient1_constant": {
                            "type": "number"
                        },
                        "coefficient2_x": {
                            "type": "number"
                        },
                        "minimum_value_of_x": {
