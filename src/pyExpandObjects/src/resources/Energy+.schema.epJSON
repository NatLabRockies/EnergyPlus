                    ]
                },
                "numerics": {
                    "fields": [
                        "apratio_the_area_to_perimeter_ratio_for_this_slab"
                    ]
                }
            },
            "type": "object",
            "memo": "Using an equivalent slab allows non-rectangular shapes to be modeled accurately. The simulation default should be EquivSizing=True"
        },
