        "AirflowNetwork:Distribution:Component:ConstantPressureDrop": {
            "patternProperties": {
                "^.*\\S.*$": {
                    "type": "object",
                    "properties": {
                        "pressure_difference_across_the_component": {
                            "type": "number",
                            "units": "Pa",
                            "minimum": 0.0,
                            "exclusiveMinimum": true,
                            "note": "Enter the pressure drop across this component."
                        }
                    },
                    "required": [
                        "pressure_difference_across_the_component"
                    ]
                }
            },
            "group": "AirflowNetwork",
            "name": {
                "type": "string",
