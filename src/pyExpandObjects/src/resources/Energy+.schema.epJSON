            "type": "object",
            "memo": "property values for fluid properties list of up to 250 temperatures, note that number of property values must match the number of properties in other words, there must be a one-to-one correspondence between the property values in this list and the actual properties list in other syntax degrees C (for all temperature inputs)",
            "format": "FluidProperty"
        },
        "FluidProperties:Saturated": {
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties": {
                        "fluid_name": {
                            "type": "string",
