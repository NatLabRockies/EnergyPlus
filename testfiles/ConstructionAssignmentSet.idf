! ConstructionAssignmentSet.idf
!
! Basic file description: 4 Spaces / 4 Zones, two per floor, stacked: Space1/Space2 on the
!                          ground floor (side by side), Space3/Space4 directly above them on
!                          the second floor. Space1<->Space2 and Space3<->Space4 share an
!                          interior wall; Space1<->Space3 and Space2<->Space4 share an
!                          interzone floor/ceiling. Space2 has one Adiabatic wall and a Ground
!                          floor/wall; the rest of the envelope is Exterior.
!
! Highlights:              Exercises the ConstructionAssignmentSet / SurfaceConstructionAssignments /
!                          SubSurfaceConstructionAssignments objects (NFP-DefaultConstructionSet):
!                          almost every surface and sub-surface has a blank Construction Name and
!                          instead relies on inherited construction assignments, resolved with the
!                          following precedence, from highest to lowest:
!                            1. Explicit: the surface's own (non-blank) Construction Name field.
!                               "Space1 Wall 3" is the only surface that keeps one, to exercise
!                               this tier.
!                            2. Space: the Space's own Construction Assignment Set Name field.
!                               Space3 references "Space3 Construction Set", which only fills out
!                               the Exterior Wall Construction Name (as "Exterior Wall Construction
!                               - Space3") - every other surface type in Space3 falls through to
!                               the Building-level set instead.
!                            3. Building: the Building object's Construction Assignment Set Name
!                               field, "Default Construction Set", which is the fallback for every
!                               other surface/sub-surface in the model.
!                          Interzone pairs (Space1/Space2 wall, Space3/Space4 wall, Space1-Space3
!                          and Space2-Space4 floor/ceiling, and the interior door/window on the
!                          Space1/Space2 wall) are only assigned a construction on one side; the
!                          other side is expected to be auto-resolved to the reverse-layer-order
!                          construction.
!
!                          Also exercises the new SubSurface Types added alongside this NFP:
!                          FixedWindow, OperableWindow, and Skylight (which map to the legacy
!                          "Window" type), and OverheadDoor (which maps to the legacy "Door" type).
!                          The legacy "Window", "Door", and "GlassDoor" types are used as well, so
!                          both old and new types get their own SubSurfaceConstructionAssignments row.
!
!                          "Space1 Furniture" (InternalMass, blank Construction Name) exercises
!                          resolution of the Building-level set's Interior Partition Construction
!                          Name field.
!
! Simulation Location/Run: CHICAGO_IL_USA TMY2-94846, 2 design days
!
! Location:                Chicago, IL

  Version,26.2;

  Timestep,6;

  Building,
    Building 1,              !- Name
    ,                        !- North Axis {deg}
    ,                        !- Terrain
    ,                        !- Loads Convergence Tolerance Value {W}
    ,                        !- Temperature Convergence Tolerance Value {deltaC}
    ,                        !- Solar Distribution
    ,                        !- Maximum Number of Warmup Days
    ,                        !- Minimum Number of Warmup Days
    Default Construction Set;  !- Construction Assignment Set Name

  Zone,
    Zone1,                   !- Name
    ,                        !- Direction of Relative North {deg}
    0.0,                     !- X Origin {m}
    0.0,                     !- Y Origin {m}
    0.0,                     !- Z Origin {m}
    ,                        !- Type
    1,                       !- Multiplier
    ,                        !- Ceiling Height {m}
    ,                        !- Volume {m3}
    ,                        !- Floor Area {m2}
    ,                        !- Zone Inside Convection Algorithm
    ,                        !- Zone Outside Convection Algorithm
    Yes;                     !- Part of Total Floor Area

  Space,
    Space1,                  !- Name
    Zone1,                   !- Zone Name
    ,                        !- Ceiling Height {m}
    ,                        !- Volume {m3}
    ,                        !- Floor Area {m2}
    ;                        !- Space Type

  InternalMass,
    Space1 Furniture,        !- Name
    ,                        !- Construction Name
    ,                        !- Zone or ZoneList Name
    Space1,                  !- Space or SpaceList Name
    10;                      !- Surface Area {m2}

