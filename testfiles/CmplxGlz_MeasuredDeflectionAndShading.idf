!       Window Glass Layers
!-----------------------------------------------------

  WindowMaterial:Glazing,
    Glass_2027_Layer,        !- Name
    BSDF,                    !- Optical Data Type
    Glass_2027_Layer_SpecDat,!- Window Glass Spectral Data Set Name
    0.004000,                !- Thickness {m}
    ,                        !- Solar Transmittance at Normal Incidence
    ,                        !- Front Side Solar Reflectance at Normal Incidence
    ,                        !- Back Side Solar Reflectance at Normal Incidence
    ,                        !- Visible Transmittance at Normal Incidence
    ,                        !- Front Side Visible Reflectance at Normal Incidence
    ,                        !- Back Side Visible Reflectance at Normal Incidence
    0.000000,                !- Infrared Transmittance at Normal Incidence
    0.840000,                !- Front Side Infrared Hemispherical Emissivity
    0.036750,                !- Back Side Infrared Hemispherical Emissivity
    1.000000,                !- Conductivity {W/m-K}
    ,                        !- Dirt Correction Factor for Solar and Visible Transmittance
    ,                        !- Solar Diffusing
    7.2e10,                  !- Young's modulus {Pa}
    0.22;                    !- Poisson's ratio

  WindowMaterial:Glazing,
    Glass_888_Layer,         !- Name
    BSDF,                    !- Optical Data Type
    Glass_888_Layer_SpecDat, !- Window Glass Spectral Data Set Name
    0.003962,                !- Thickness {m}
    ,                        !- Solar Transmittance at Normal Incidence
    ,                        !- Front Side Solar Reflectance at Normal Incidence
    ,                        !- Back Side Solar Reflectance at Normal Incidence
    ,                        !- Visible Transmittance at Normal Incidence
    ,                        !- Front Side Visible Reflectance at Normal Incidence
    ,                        !- Back Side Visible Reflectance at Normal Incidence
    0.000000,                !- Infrared Transmittance at Normal Incidence
    0.840000,                !- Front Side Infrared Hemispherical Emissivity
    0.840000,                !- Back Side Infrared Hemispherical Emissivity
    1.000000,                !- Conductivity {W/m-K}
    ,                        !- Dirt Correction Factor for Solar and Visible Transmittance
    ,                        !- Solar Diffusing
    7.2e10,                  !- Young's modulus {Pa}
    0.22;                    !- Poisson's ratio

  WindowMaterial:Glazing,
    Glass_2027F_Layer,       !- Name
    BSDF,                    !- Optical Data Type
    Glass_2027F_Layer_SpecDat,  !- Window Glass Spectral Data Set Name
    0.004000,                !- Thickness {m}
    ,                        !- Solar Transmittance at Normal Incidence
    ,                        !- Front Side Solar Reflectance at Normal Incidence
    ,                        !- Back Side Solar Reflectance at Normal Incidence
    ,                        !- Visible Transmittance at Normal Incidence
    ,                        !- Front Side Visible Reflectance at Normal Incidence
    ,                        !- Back Side Visible Reflectance at Normal Incidence
    0.000000,                !- Infrared Transmittance at Normal Incidence
    0.036750,                !- Front Side Infrared Hemispherical Emissivity
    0.840000,                !- Back Side Infrared Hemispherical Emissivity
    1.000000,                !- Conductivity {W/m-K}
    ,                        !- Dirt Correction Factor for Solar and Visible Transmittance
    ,                        !- Solar Diffusing
    7.2e10,                  !- Young's modulus {Pa}
    0.22;                    !- Poisson's ratio

!-----------------------------------------------------
!         Deflection State
!-----------------------------------------------------

  WindowGap:DeflectionState,
    DeflectionState_813_Measured_Gap_1,  !- Name
    0.0120;                  !- Deflected Thickness {m}

  WindowGap:DeflectionState,
    DeflectionState_813_Measured_Gap_2,  !- Name
    0.0120;                  !- Deflected Thickness {m}

  WindowGap:DeflectionState,
    DeflectionState_813_Measured_Gap_3,  !- Name
    0.0120;                  !- Deflected Thickness {m}

!----------------------------------------------------------------------
!         Window Gas Layers
!----------------------------------------------------------------------

  WindowMaterial:GasMixture,
    Gap_6_W_0_0060,          !- Name
    0.0060,                  !- Thickness {m}
    2,                       !- Number of Gases in Mixture
    Air,                     !- Gas 1 Type
    0.10,                    !- Gas 1 Fraction
    Krypton,                 !- Gas 2 Type
    0.90;                    !- Gas 2 Fraction

!----------------------------------------------------------------------
!         Window Gap Layers
!----------------------------------------------------------------------

  WindowMaterial:Gap,
    Gap_6_Layer,             !- Name
    0.0060,                  !- Thickness {m}
    Gap_6_W_0_0060,          !- Gas (or Gas Mixture)
    101300.0000,             !- Pressure {Pa}
    DeflectionState_813_Measured_Gap_1;  !- Deflection State

!----------------------------------------------------------------------
!         Thermal Model Params
!----------------------------------------------------------------------

  WindowThermalModel:Params,
    ThermParam_813,          !- Name
    ISO15099,                !- standard
    ISO15099,                !- Thermal Model
    1.0000,                  !- SDScalar
    MeasuredDeflection;      !- Deflection Model

!----------------------------------------------------------------------
!         Complex Fenestration State
!----------------------------------------------------------------------

  Construction:ComplexFenestrationState,
    CFS_Glz_813,             !- Name
    LBNLWindow,              !- Basis Type
    None,                    !- Basis Symmetry Type
    ThermParam_813,          !- Window Thermal Model
    CFS_Glz_813_Basis,       !- Basis Matrix Name
    CFS_Glz_813_TfSol,       !- Solar Optical Complex Front Transmittance Matrix Name
    CFS_Glz_813_RbSol,       !- Solar Optical Complex Back Reflectance Matrix Name
    CFS_Glz_813_Tfvis,       !- Visible Optical Complex Front Transmittance Matrix Name
    CFS_Glz_813_Tbvis,       !- Visible Optical Complex Back Transmittance Matrix Name
    Glass_2027_Layer,        !- Outside Layer Name
    CFS_Glz_813_Layer_1_fAbs,!- Outside Layer Directional Front Absorptance Matrix Name
    CFS_Glz_813_Layer_1_bAbs,!- Outside Layer Directional Back Absorptance Matrix Name
    Gap_6_Layer,             !- Gap 1 Name
    ,                        !- CFS Gap 1 Directional Front Absorptance Matrix Name
    ,                        !- CFS Gap 1 Directional Back Absorptance Matrix Name
    Glass_888_Layer,         !- Layer 2 Name
    CFS_Glz_813_Layer_2_fAbs,!- Layer 2 Directional Front Absorptance Matrix Name
    CFS_Glz_813_Layer_2_bAbs,!- Layer 2 Directional Back Absorptance Matrix Name
    Gap_6_Layer,             !- Gap 2 Name
    ,                        !- Gap 2 Directional Front Absorptance Matrix Name
    ,                        !- Gap 2 Directional Back Absorptance Matrix Name
    Glass_2027F_Layer,       !- Layer 3 Name
    CFS_Glz_813_Layer_3_fAbs,!- Layer 3 Directional Front Absorptance Matrix Name
    CFS_Glz_813_Layer_3_bAbs,!- Layer 3 Directional Back Absorptance Matrix Name
    Gap_6_Layer,             !- Gap 3 Name
    ,                        !- Gap 3 Directional Front Absorptance Matrix Name
    ,                        !- Gap 3 Directional Back Absorptance Matrix Name
    Glass_888_Layer,         !- Layer 4 Name
    CFS_Glz_813_Layer_4_fAbs,!- Layer 4 Directional Front Absorptance Matrix Name
    CFS_Glz_813_Layer_4_bAbs;!- Layer 4 Directional Back Absorptance Matrix Name

