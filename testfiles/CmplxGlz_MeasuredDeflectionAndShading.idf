!
!    Double clear with in-between shading
!
!**********************************************************************************************************************************
!**********************************************************************************************************************************
!-----------------------------------------------------
!       Window Glass Layers
!-----------------------------------------------------

  WindowMaterial:Glazing,
    Glass_5012_Layer,        !- Name
    BSDF,                    !- Optical Data Type
    Glass_5012_Layer_SpecDat,!- Window Glass Spectral Data Set Name
    0.005664,                !- Thickness {m}
    ,                        !- Solar Transmittance at Normal Incidence
    ,                        !- Front Side Solar Reflectance at Normal Incidence
    ,                        !- Back Side Solar Reflectance at Normal Incidence
    ,                        !- Visible Transmittance at Normal Incidence
    ,                        !- Front Side Visible Reflectance at Normal Incidence
    ,                        !- Back Side Visible Reflectance at Normal Incidence
    0.000000,                !- Infrared Transmittance at Normal Incidence
    0.840000,                !- Front Side Infrared Hemispherical Emissivity
    0.840000,                !- Back Side Infrared Hemispherical Emissivity
    1.000000,                !- Conductivity {W/m-K}
    ,                        !- Dirt Correction Factor for Solar and Visible Transmittance
    ,                        !- Solar Diffusing
    7.2e10,                  !- Young's modulus {Pa}
    0.22;                    !- Poisson's ratio

!----------------------------------------------------------------------
!         Complex Shade
!----------------------------------------------------------------------

  WindowMaterial:ComplexShade,
    Shade_25_Layer,          !- Name
    Perforated,              !- Layer Type
    5.000000e-003,           !- Thickness {m}
    1.700000e+001,           !- Conductivity {W/m-K}
    0.000000e+000,           !- IR Transmittance
    2.000000e-001,           !- Front Emissivity
    2.000000e-001,           !- Back Emissivity
    0.000000e+000,           !- Top Opening Multiplier
    0.000000e+000,           !- Bottom Opening Multiplier
    0.000000e+000,           !- Left Side Opening Multiplier
    0.000000e+000,           !- Right Side Opening Multiplier
    5.000000e-002;           !- Front Opening Multiplier

!----------------------------------------------------------------------
!         Window Gas Layers
!----------------------------------------------------------------------

  WindowMaterial:Gas,
    Gap_1_W_0_0058,          !- Name
    Air,                     !- Gas Type
    0.0058;                  !- Thickness {m}

!----------------------------------------------------------------------
!         Window Gap Layers
!----------------------------------------------------------------------

  WindowMaterial:Gap,
    Gap_1_Layer,             !- Name
    0.0058,                  !- Thickness {m}
    Gap_1_W_0_0058,          !- Gas (or Gas Mixture)
    101300.0000;             !- Pressure {Pa}

!----------------------------------------------------------------------
!         Thermal Model Params
!----------------------------------------------------------------------

  WindowThermalModel:Params,
    ThermParam_2015,         !- Name
    ISO15099,                !- standard
    ISO15099,                !- Thermal Model
    1.0000,                  !- SDScalar
    NoDeflection;            !- Deflection Model

